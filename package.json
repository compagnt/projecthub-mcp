{
  "name": "projecthub-mcp",
  "version": "1.0.0",
  "description": "MCP server for ProjectHub project management",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "projecthub-mcp": "dist/index.js",
    "projecthub-mcp-http": "dist/http.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0"
  }
}
